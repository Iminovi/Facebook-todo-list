rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'displayName', 'soundEnabled', 'notificationsEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'soundEnabled', 'notificationsEnabled', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.soundEnabled is bool
        && data.notificationsEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFbAccount(data) {
      return data.keys().hasAll(['ownerId', 'name', 'username', 'profileUrl', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'username', 'profileUrl', 'isActive', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.username is string
        && data.username.size() <= 80
        && data.profileUrl is string
        && data.profileUrl.size() <= 240
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyCheck(data) {
      return data.keys().hasAll(['ownerId', 'dateKey', 'accountId', 'loggedIn', 'uploaded', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'dateKey', 'accountId', 'loggedIn', 'uploaded', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.accountId is string
        && isValidId(data.accountId)
        && data.loggedIn is bool
        && data.uploaded is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReminder(data) {
      return data.keys().hasAll(['ownerId', 'label', 'time', 'targetType', 'enabled', 'lastTriggeredDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'label', 'time', 'targetType', 'enabled', 'lastTriggeredDate', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.label is string
        && data.label.size() >= 1
        && data.label.size() <= 80
        && data.time is string
        && data.time.size() == 5
        && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.targetType is string
        && data.targetType in ['login', 'upload', 'both']
        && data.enabled is bool
        && data.lastTriggeredDate is string
        && data.lastTriggeredDate.size() <= 10
        && (data.lastTriggeredDate == '' || data.lastTriggeredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId)
        && isOwner(userId)
        && (resource == null || existing().ownerId == request.auth.uid);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'soundEnabled', 'notificationsEnabled', 'updatedAt']);
      allow delete: if false;

      match /fbAccounts/{accountId} {
        allow get: if isValidId(userId)
          && isValidId(accountId)
          && isOwner(userId)
          && (resource == null || existing().ownerId == request.auth.uid);
        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(accountId)
          && isOwner(userId)
          && isValidFbAccount(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(accountId)
          && isOwner(userId)
          && isValidFbAccount(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'username', 'profileUrl', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'updatedAt'])
          )
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(userId)
          && isValidId(accountId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }

      match /dailyChecks/{checkId} {
        allow get: if isValidId(userId)
          && isValidId(checkId)
          && isOwner(userId)
          && (resource == null || existing().ownerId == request.auth.uid);
        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(checkId)
          && isOwner(userId)
          && isValidDailyCheck(incoming())
          && checkId == (incoming().dateKey + '__' + incoming().accountId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId)/fbAccounts/$(incoming().accountId));
        allow update: if isValidId(userId)
          && isValidId(checkId)
          && isOwner(userId)
          && isValidDailyCheck(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().dateKey == existing().dateKey
          && incoming().accountId == existing().accountId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['loggedIn', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['uploaded', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['loggedIn', 'uploaded', 'updatedAt'])
          )
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(userId)
          && isValidId(checkId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }

      match /reminders/{reminderId} {
        allow get: if isValidId(userId)
          && isValidId(reminderId)
          && isOwner(userId)
          && (resource == null || existing().ownerId == request.auth.uid);
        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(reminderId)
          && isOwner(userId)
          && isValidReminder(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(userId)
          && isValidId(reminderId)
          && isOwner(userId)
          && isValidReminder(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['label', 'time', 'targetType', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['enabled', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['lastTriggeredDate', 'updatedAt'])
          )
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(userId)
          && isValidId(reminderId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
